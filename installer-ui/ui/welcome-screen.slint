import { Theme } from "./theme.slint";
import { ActionLabel } from "./widgets/action-label.slint";
import { Hairline } from "./widgets/hairline.slint";

export component WelcomeScreen inherits Rectangle {
    width: 100%;
    height: 100%;
    forward-focus: key-handler;

    in property <string> kernel-version: "7.1.4";
    in property <string> tty-name: "tty1";
    in property <string> installer-version: "0.1.0";
    in property <float> gutter-scale: 1.0;

    property <int> selected-index: 0;

    callback install();
    callback reboot();
    callback exit-installer();

    VerticalLayout {
        Rectangle {
            height: Theme.header-height;
            horizontal-stretch: 1;

            HorizontalLayout {
                padding-left: Theme.gutter-outer;
                padding-right: Theme.gutter-outer;
                spacing: 22px;

                Image {
                    source: @image-url("../assets/finix-logo.svg");
                    width: 26px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-label: "finix";
                }

                Text {
                    text: "finix installer";
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "linux " + kernel-version + " · " + tty-name;
                    color: Theme.text-disabled;
                    font-size: Theme.font-info;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }

            Hairline {
                y: parent.height - 1px;
                width: parent.width;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            VerticalLayout {
                padding-left: Theme.content-gutter * gutter-scale;
                padding-right: Theme.content-gutter * gutter-scale;
                padding-top: Theme.content-gutter-top;
                alignment: start;
                spacing: 35px;

                Text {
                    text: "finix";
                    color: Theme.text-primary;
                    font-size: Theme.font-display;
                    letter-spacing: 1px;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "a daily-drivable experiment in what nixos could look like,";
                        color: Theme.text-secondary;
                        font-size: Theme.font-meta;
                    }
                    Text {
                        text: "running finit as pid 1.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-meta;
                    }
                }

                Rectangle {
                    height: 1px;
                    width: 77px;
                    background: Theme.border-subtle;
                }

                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;

                    ActionLabel {
                        label: "install >";
                        label-color: Theme.accent;
                        label-font-size: Theme.font-title;
                        selected: selected-index == 0;
                        clicked => { root.selected-index = 0; root.install(); }
                    }
                    ActionLabel {
                        label: "reboot";
                        label-color: Theme.text-quiet;
                        label-font-size: Theme.font-meta;
                        selected: selected-index == 1;
                        clicked => { root.selected-index = 1; root.reboot(); }
                    }
                    ActionLabel {
                        label: "exit";
                        label-color: Theme.text-quiet;
                        label-font-size: Theme.font-meta;
                        selected: selected-index == 2;
                        clicked => { root.selected-index = 2; root.exit-installer(); }
                    }
                }
            }
        }

        Rectangle {
            height: Theme.footer-height;
            horizontal-stretch: 1;

            Text {
                x: Theme.gutter-outer;
                text: "finix-installer " + installer-version;
                color: Theme.text-faint;
                font-size: Theme.font-info;
                vertical-alignment: center;
            }
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.selected-index = root.selected-index < 2 ? root.selected-index + 1 : 2;
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.selected-index = root.selected-index > 0 ? root.selected-index - 1 : 0;
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.selected-index == 0) {
                    root.install();
                }
                if (root.selected-index == 1) {
                    root.reboot();
                }
                if (root.selected-index == 2) {
                    root.exit-installer();
                }
                return accept;
            }
            reject
        }
    }
}