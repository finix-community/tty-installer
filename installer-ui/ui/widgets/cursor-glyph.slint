import { Theme } from "../theme.slint";

export component CursorGlyph inherits Path {
    in property <length> pos-x;
    in property <length> pos-y;
    x: pos-x;
    y: pos-y;
    width: 20px;
    height: 28px;
    commands: "M 0 0 L 0 19 L 4.8 14.3 L 8.2 21.8 L 11.2 20.4 L 7.9 13 L 14.3 13 Z";
    fill: Theme.accent;
    stroke: Theme.bg;
    stroke-width: 1px;
}
