import { Theme } from "../theme.slint";
import { Hairline } from "./hairline.slint";

export component StepBar inherits Rectangle {
    in property <string> active-step;

    in property <string> locale-step: "locale";
    in property <string> network-step: "network";
    in property <string> providers-step: "providers";
    in property <string> disk-step: "disk";
    in property <string> account-step: "account";
    in property <string> summary-step: "summary";

    height: Theme.header-height;
    horizontal-stretch: 1;

    HorizontalLayout {
        padding-left: Theme.gutter-outer;
        padding-right: Theme.gutter-outer;

        Text {
            text: "finix";
            color: Theme.text-primary;
            font-size: Theme.font-title;
            letter-spacing: 1px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            spacing: 38px;
            Text { text: locale-step; color: active-step == "locale" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
            Text { text: network-step; color: active-step == "network" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
            Text { text: providers-step; color: active-step == "providers" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
            Text { text: disk-step; color: active-step == "disk" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
            Text { text: account-step; color: active-step == "account" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
            Text { text: summary-step; color: active-step == "summary" ? Theme.accent : Theme.text-quiet; font-size: Theme.font-info; vertical-alignment: center; }
        }
    }

    Hairline {
        y: parent.height - 1px;
        width: parent.width;
    }
}